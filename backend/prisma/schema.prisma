generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  STAFF
  CUSTOMER
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  ROCKET
  CARD
  BANK
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum InstallmentStatus {
  UPCOMING
  PARTIAL
  PAID
  OVERDUE
}

model User {
  id           String       @id @default(uuid())
  name         String
  phone        String       @unique
  passwordHash String
  role         UserRole     @default(CUSTOMER)
  language     String       @default("bn")
  active       Boolean      @default(true)
  memberships  ShopMember[]
  ownedShops   Shop[]        @relation("ShopOwner")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Shop {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  ownerId     String
  owner       User         @relation("ShopOwner", fields: [ownerId], references: [id])
  members     ShopMember[]
  customers   Customer[]
  credits     CreditAccount[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ShopMember {
  id        String   @id @default(uuid())
  shopId    String
  userId    String
  role      UserRole
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([shopId, userId])
  @@index([userId])
}

model Customer {
  id        String         @id @default(uuid())
  shopId    String
  shop      Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  address   String?
  credits   CreditAccount[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  @@index([shopId, name])
  @@index([shopId, phone])
}

model CreditAccount {
  id          String        @id @default(uuid())
  shopId      String
  customerId  String
  shop        Shop          @relation(fields: [shopId], references: [id])
  customer    Customer      @relation(fields: [customerId], references: [id])
  description String?
  totalAmount Decimal       @db.Decimal(14, 2)
  createdAt   DateTime      @default(now())
  installments Installment[]
  payments    Payment[]
  @@index([shopId, customerId])
}

model Installment {
  id          String             @id @default(uuid())
  creditId    String
  credit      CreditAccount      @relation(fields: [creditId], references: [id], onDelete: Cascade)
  amount      Decimal            @db.Decimal(14, 2)
  paidAmount  Decimal            @default(0) @db.Decimal(14, 2)
  dueDate     DateTime
  status      InstallmentStatus  @default(UPCOMING)
  createdAt   DateTime           @default(now())
  allocations PaymentAllocation[]
  @@index([creditId, dueDate])
}

model Payment {
  id          String             @id @default(uuid())
  creditId    String
  credit      CreditAccount      @relation(fields: [creditId], references: [id])
  amount      Decimal            @db.Decimal(14, 2)
  method      PaymentMethod
  status      PaymentStatus      @default(PENDING)
  reference   String?
  receivedAt  DateTime?
  createdAt   DateTime           @default(now())
  allocations PaymentAllocation[]
  @@index([creditId, status])
}

model PaymentAllocation {
  id             String      @id @default(uuid())
  paymentId      String
  installmentId  String
  amount         Decimal     @db.Decimal(14, 2)
  payment        Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  installment    Installment @relation(fields: [installmentId], references: [id])
  @@unique([paymentId, installmentId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  shopId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([shopId, createdAt])
}

model GatewayEvent {
  id          String   @id @default(uuid())
  provider    String
  eventId     String   @unique
  payload     Json
  processedAt DateTime?
  createdAt   DateTime @default(now())
}
